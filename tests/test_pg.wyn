// pg tests - requires PostgreSQL running locally
// Skip gracefully if not available

test "conninfo has host" {
    // Test connection string building
    var conninfo = "host=localhost dbname=postgres user=postgres"
    assert(conninfo.contains("host="))
}

test "conninfo has dbname" {
    // Test connection string building
    var conninfo = "host=localhost dbname=postgres user=postgres"
    assert(conninfo.contains("dbname="))
}

test "param $1" {
    // Test connection string building
    var conninfo = "host=localhost dbname=postgres user=postgres"
    // Test parameter substitution
    var sql = "SELECT * FROM users WHERE id = $1 AND name = $2"
    var q = sql.replace_all("$1", "'42'").replace_all("$2", "'Alice'")
    assert(q.contains("'42'"))
}

test "param $2" {
    // Test connection string building
    var conninfo = "host=localhost dbname=postgres user=postgres"
    // Test parameter substitution
    var sql = "SELECT * FROM users WHERE id = $1 AND name = $2"
    var q = sql.replace_all("$1", "'42'").replace_all("$2", "'Alice'")
    assert(q.contains("'Alice'"))
}
